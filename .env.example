# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 含敏感信息，请设置权限 chmod 600 .env，且不要提交到代码仓库

# ---------- 必填：主密钥（用于 AES-256-GCM 加密存储 AccessKey） ----------
# 生成：openssl rand -base64 32
# 请单独妥善保管；更换后已保存的 AccessKey 将无法解密，需在管理页面重新填写
APP_MASTER_KEY=

# ---------- 初始管理员（仅在数据库中没有任何用户时生效） ----------
ADMIN_USERNAME=admin
# 留空则随机生成并打印在容器日志中（docker compose logs app），首次登录强制修改
# 自定义时需至少 10 位且包含字母和数字
ADMIN_PASSWORD=

# ---------- 网络 ----------
# 对外端口与绑定地址；启用 https profile 时请设 BIND_ADDR=127.0.0.1，只让 Caddy 对外
HTTP_PORT=8080
BIND_ADDR=0.0.0.0
# 位于反向代理（Caddy / Nginx / SLB）之后时设为 true
TRUST_PROXY=false
# Cookie Secure 标记：auto（HTTPS 时自动）/ true / false
COOKIE_SECURE=auto
# 使用 https profile 时填写解析到本机的域名，例如 cost.example.com
DOMAIN=
# 可选：IP 白名单（逗号分隔，支持 CIDR），留空不限制，例如 10.0.0.0/8,203.0.113.10
ALLOW_CIDRS=

# ---------- 会话与登录 ----------
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_PER_IP=20

# ---------- 账单时区（阿里云按北京时间划分自然日，一般不需修改） ----------
BILL_TZ=Asia/Shanghai

# ---------- 可选：首次启动自动导入访问密钥（导入后加密存库，建议随后从 .env 删除） ----------
# 推荐直接在“系统管理 → 阿里云接入 / 腾讯云接入”页面配置
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ---------- 可选：告警通知（渠道在“系统管理 → 告警通知”页面配置） ----------
# 对外访问地址，用于告警消息中的“打开费用分析”链接，例如 https://cost.example.com
PUBLIC_URL=
# 允许通用 Webhook 指向内网地址（默认 false，防止 SSRF；仅在接收端位于内网时开启）
ALERT_ALLOW_PRIVATE=false

# ---------- 可选：自动备份（数据卷 /data/backups） ----------
# 每天保留最近 N 份（0 关闭），备份时间为账单时区的整点
BACKUP_KEEP=7
BACKUP_HOUR=3

# ---------- 可选：Prometheus 指标 ----------
# 设置 ≥16 位随机令牌后开启 GET /metrics（Authorization: Bearer <令牌>），生成：openssl rand -hex 24
METRICS_TOKEN=

# ---------- 仅测试 / 私有网关：覆盖腾讯云 API 地址（生产环境请留空） ----------
TENCENT_ENDPOINT_OVERRIDE=
